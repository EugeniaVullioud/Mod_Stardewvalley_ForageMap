<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ForageTrackerModSV</AssemblyName>
    <RootNamespace>ForageTrackerModSV</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="customHoverMappings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="customHoverMappings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

</Project>
